{
  "schema_version": "1",
  "kind": "labpod.template.bundle",
  "id_hint": "cookbook-cheminformatics",
  "name": "Cheminformatics (Cookbook)",
  "description": "CPU-only JupyterLab on the LabPod SciPy composite image (ghcr.io/labpod/scipy-jupyter:v1-py312; no CUDA needed) plus rdkit, built from this template's Dockerfile. Molecule parsing, descriptors, and similarity search. See github.com/LabPod/labpod-cookbook/tree/main/cheminformatics.",
  "type": "jupyter",
  "image": {
    "ref": "localhost/labpod-cookbook/cheminformatics:latest",
    "dockerfile": {
      "path": "Dockerfile"
    },
    "published": {
      "ref": "ghcr.io/labpod/labpod-cookbook-cheminformatics:v1-cpu",
      "definition_digest": "sha256:905b8a649838555b1d17612967c13c205bda8c0b54272b3cce30927593d8e562"
    }
  },
  "defaults": {
    "cpu": 4,
    "memory_gb": 8,
    "gpu_required": false,
    "gpu_default": false,
    "app_port": 8888,
    "base_url_arg": "--ServerApp.base_url",
    "sleep_entrypoint": true
  },
  "requires_eula": false,
  "ports": [
    {
      "name": "jupyter",
      "label": "JupyterLab",
      "container_port": 8888,
      "protocol": "http",
      "base_path_arg": "--ServerApp.base_url",
      "is_primary": true,
      "command_template": "jupyter lab --ServerApp.ip=0.0.0.0 --ServerApp.port=${HOST_PORT} --ServerApp.open_browser=False --ServerApp.token=${AUTH_TOKEN} --ServerApp.password= --ServerApp.base_url=${BASE_PATH} --ServerApp.root_dir=/work",
      "readiness_path": "/lab",
      "probe_command": "jupyter",
      "install_hint": "uv pip install --system jupyterlab",
      "option_schema_json": "{\"fields\":[]}",
      "proxy_strip_prefix": false
    }
  ]
}
