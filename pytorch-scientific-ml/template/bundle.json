{
  "schema_version": "1",
  "kind": "labpod.template.bundle",
  "id_hint": "cookbook-pytorch-scientific-ml",
  "name": "PyTorch Scientific ML (Cookbook)",
  "description": "PyTorch JupyterLab with TensorBoard inherited from the LabPod PyTorch composite image (ghcr.io/labpod/pytorch-jupyter:cu126), plus MLflow added by this template's Dockerfile (see context/requirements.txt). Shared by several labpod-cookbook notebooks; most log training curves for TensorBoard, and selected examples also log MLflow runs, metrics, models, and artifacts - import and build this once, then run any of them. See github.com/LabPod/labpod-cookbook/tree/main/pytorch-scientific-ml.",
  "type": "jupyter",
  "image": {
    "ref": "localhost/labpod-cookbook/pytorch-scientific-ml:latest",
    "dockerfile": {
      "path": "Dockerfile"
    },
    "published": {
      "ref": "ghcr.io/labpod/labpod-cookbook-pytorch-scientific-ml:v1-cu126",
      "definition_digest": "sha256:3fa8a8f56d6f20c32a449f7722ce68aa59df70cfbac63a4b0c0261919dc890ce",
      "variants": [
        {
          "ref": "ghcr.io/labpod/labpod-cookbook-pytorch-scientific-ml:v1-cu121",
          "definition_digest": "sha256:41f63b04435c8c325dab4315a43f3d050df9febb24fbab3a8a933a3855b1cd1f",
          "build_args": {
            "LABPOD_BASE_IMAGE": "ghcr.io/labpod/pytorch-jupyter:cu121"
          }
        },
        {
          "ref": "ghcr.io/labpod/labpod-cookbook-pytorch-scientific-ml:v1-cu129",
          "definition_digest": "sha256:708e2b18bad01206bdb786be84c32daec2a31a0b3a4e5953abb99b63de35a8f6",
          "build_args": {
            "LABPOD_BASE_IMAGE": "ghcr.io/labpod/pytorch-jupyter:cu129"
          }
        }
      ]
    }
  },
  "defaults": {
    "cpu": 4,
    "memory_gb": 16,
    "gpu_required": false,
    "gpu_default": true,
    "app_port": 8888,
    "base_url_arg": "--ServerApp.base_url",
    "sleep_entrypoint": true
  },
  "requires_eula": false,
  "ports": [
    {
      "name": "jupyter",
      "label": "JupyterLab",
      "container_port": 8888,
      "protocol": "http",
      "base_path_arg": "--ServerApp.base_url",
      "is_primary": true,
      "command_template": "jupyter lab --ServerApp.ip=0.0.0.0 --ServerApp.port=${HOST_PORT} --ServerApp.open_browser=False --ServerApp.token=${AUTH_TOKEN} --ServerApp.password= --ServerApp.base_url=${BASE_PATH} --ServerApp.root_dir=/work",
      "readiness_path": "/lab",
      "probe_command": "jupyter",
      "install_hint": "uv pip install --system jupyterlab",
      "option_schema_json": "{\"fields\":[]}",
      "proxy_strip_prefix": false
    },
    {
      "name": "tensorboard",
      "label": "TensorBoard",
      "container_port": 6006,
      "protocol": "http",
      "base_path_arg": "--tensorboard.path_prefix",
      "is_primary": false,
      "command_template": "tensorboard --host=0.0.0.0 --port=${HOST_PORT} --path_prefix=${BASE_PATH} --logdir=${LOGDIR}",
      "readiness_path": "/",
      "probe_command": "tensorboard",
      "install_hint": "included in the LabPod PyTorch base image",
      "option_schema_json": "{\"fields\":[{\"name\":\"LOGDIR\",\"type\":\"directory\",\"label\":\"Log directory\",\"default\":\"/work/runs\",\"help\":\"Every notebook in this cookbook logs to /work/runs/<name> - pick the parent runs/ folder to see all of them, or a specific subfolder for just one.\"}]}",
      "proxy_strip_prefix": false
    },
    {
      "name": "mlflow",
      "label": "MLflow",
      "container_port": 5000,
      "protocol": "http",
      "base_path_arg": "--static-prefix",
      "is_primary": false,
      "command_template": "mlflow ui --host=0.0.0.0 --port=${HOST_PORT} --backend-store-uri=file:///work/mlruns --static-prefix=${BASE_PATH}",
      "readiness_path": "/",
      "probe_command": "mlflow",
      "install_hint": "already installed by this template's Dockerfile",
      "option_schema_json": "{\"fields\":[]}",
      "proxy_strip_prefix": false
    }
  ]
}
